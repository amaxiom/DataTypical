# Byte-compiled and packaging artefacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Test and coverage artefacts
.pytest_cache/
.coverage
.coverage.*
coverage_html/
htmlcov/
.tox/

# Cached benchmark datasets: 168 MB, and every loader re-downloads on demand
benchmarks/data/

# Long-run benchmark logs (results CSVs, summaries and figures ARE tracked).
# Three exceptions, each a few hundred bytes: they are the ONLY record of numbers
# that FINDINGS.md quotes, and a citation a reader cannot open is not a citation.
benchmarks/results/*.log
!benchmarks/results/tv_pneumonia.log
!benchmarks/results/pi_diagnostic.log
!benchmarks/results/b_sweep_breast.log
benchmarks/results_pre_sweep/
examples/*.log

# Environments and editors
.venv/
venv/
env/
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# throwaway venv used by the release check
.venv-rpmcheck/

# mypy cache, created by the type-check guard in tests/test_staging.py
.mypy_cache/
